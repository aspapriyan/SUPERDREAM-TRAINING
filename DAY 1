class Solution {
        public int maxSubArray(int[] nums) {
                int res = nums[0];
                        int total = 0;

                                for (int n : nums) {
                                            if (total < 0) {
                                                            total = 0;
                                                                        }

                                                                                    total += n;
                                                                                                res = Math.max(res, total);
                                                                                                        }

                                                                                                                return res;        
                                                                                                                    }
                                                                                                                    
}


class Solution {
        public boolean canJump(int[] nums) {
                int goal = nums.length - 1;

                        for (int i = nums.length - 2; i >= 0; i--) {
                                    if (i + nums[i] >= goal) {
                                                    goal = i;
                                                                }
                                                                        }

                                                                                return goal == 0;        
                                                                                    }
                                                                                    }

