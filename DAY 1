Array insertion:

import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] arr = new int[5];

        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;

        int pos = 2;
        int value = 25;

        for(int i = 3;i>=pos;i--){
            arr[i+1] = arr[i];
        }

        arr[pos] = value;

        for(int i=0;i<arr.length;i++){
            System.out.println(arr[i]);
        }       
    }
}

Array deletion:

public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 20, 30, 40, 50};

        int pos = 2;   // index to delete

        for (int i = pos; i < arr.length - 1; i++) {
            arr[i] = arr[i + 1];
        }

        // Print array after deletion
        for (int i = 0; i < arr.length - 1; i++) {
            System.out.println(arr[i]);
        }
    }
}


Array searching

public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 20, 30, 40, 50};

        int key = 30;
        boolean found = false;

        for (int i = 0; i < arr.length; i++) {

            if (arr[i] == key) {
                System.out.println("Element found at index " + i);
                found = true;
                break;
            }
        }

        if (!found) {
            System.out.println("Element not found");
        }
    }
}

class Solution 
public int arrayPairSum(int[] nums) {
Arrays.sort(nums);
int sum=0;
for(int i=0;i<nums.length;i+=2){
sum+=Math.min(nums[i],nums[i+1]);
}
return sum;
}
}

 Solution {
        public boolean isMonotonic(int[] nums) {
                int n = nums.length;
if (n == 1) return true;
boolean isInc = true;
boolean isDec = true;
for (int i = 1; i < n; i++) {
if (!isInc && !isDec) {
return false;
}
if (nums[i] < nums[i - 1]) {
isInc = false;
}
if (nums[i] > nums[i - 1]) {
isDec = false;
}
}
return isInc || isDec;        
}
}

