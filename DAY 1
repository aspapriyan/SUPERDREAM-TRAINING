class Solution 
public int arrayPairSum(int[] nums) {
Arrays.sort(nums);
int sum=0;
for(int i=0;i<nums.length;i+=2){
sum+=Math.min(nums[i],nums[i+1]);
}
return sum;
}
}

 Solution {
        public boolean isMonotonic(int[] nums) {
                int n = nums.length;
if (n == 1) return true;
boolean isInc = true;
boolean isDec = true;
for (int i = 1; i < n; i++) {
if (!isInc && !isDec) {
return false;
}
if (nums[i] < nums[i - 1]) {
isInc = false;
}
if (nums[i] > nums[i - 1]) {
isDec = false;
}
}
return isInc || isDec;        
}
}

