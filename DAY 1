Array insertion:

import java.util.*;
public class Main{
    public static void main(String[] args){
        int[] arr = new int[5];

        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;

        int pos = 2;
        int value = 25;

        for(int i = 3;i>=pos;i--){
            arr[i+1] = arr[i];
        }

        arr[pos] = value;

        for(int i=0;i<arr.length;i++){
            System.out.println(arr[i]);
        }       
    }
}

