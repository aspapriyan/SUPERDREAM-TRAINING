                                                                                                                                                                                    q.add(removal.right);
                                                                                                                                                                                                }
                                                                                                                                                                                                        }
                                                                                                                                                                                                                return list;
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                    
}


